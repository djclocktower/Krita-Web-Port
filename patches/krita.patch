 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
 
+if (EMSCRIPTEN)
+    # WebAssembly has no usable shared libraries here (Qt's dynamic linking cannot be
+    # combined with threads), so every library and plugin is linked statically.
+    function(add_library name)
+        set(args ${ARGN})
+        list(TRANSFORM args REPLACE "^(SHARED|MODULE)$" "STATIC")
+        _add_library(${name} ${args})
+        if ("MODULE" IN_LIST ARGN)
+            # plugins become Qt static plugins; KoJsonTrader lists them via QPluginLoader::staticPlugins()
+            target_compile_definitions(${name} PRIVATE QT_STATICPLUGIN)
+        endif()
+    endfunction()
+endif()
