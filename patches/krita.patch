diff --git a/cmake/modules/xsimd/xsimdMacros.cmake b/cmake/modules/xsimd/xsimdMacros.cmake
index 2dfcd10..a6c48dd 100644
--- a/cmake/modules/xsimd/xsimdMacros.cmake
+++ b/cmake/modules/xsimd/xsimdMacros.cmake
@@ -94,6 +94,10 @@ macro(xsimd_set_available_architectures)
 
    if (NOT CMAKE_OSX_ARCHITECTURES)
       string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _processor)
+      if (EMSCRIPTEN)
+         # Emscripten reports "x86"; there is no wasm SIMD implementation yet, so build scalar only
+         set(_processor "wasm32")
+      endif()
 
       list(FIND _x86_aliases "${_processor}" _has_x86)
       list(FIND _amd64_aliases "${_processor}" _has_amd64)
