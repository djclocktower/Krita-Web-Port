 set(CMAKE_POSITION_INDEPENDENT_CODE ON)
 
+if (EMSCRIPTEN)
+    # WebAssembly has no usable shared libraries here (Qt's dynamic linking cannot be
+    # combined with threads), so every library and plugin is linked statically.
+    function(add_library name)
+        set(args ${ARGN})
+        list(TRANSFORM args REPLACE "^(SHARED|MODULE)$" "STATIC")
+        # A file format's import and export plugins usually compile the same converter sources.
+        # As two shared libraries that is fine; in one binary every symbol would be defined twice.
+        # Compile the shared sources once, in whichever of the pair is declared first.
+        set(_twin "")
+        if (name MATCHES "^(.*)export$")
+            set(_twin "${CMAKE_MATCH_1}import")
+        elseif (name MATCHES "^(.*)import$")
+            set(_twin "${CMAKE_MATCH_1}export")
+        endif()
+        if (_twin AND TARGET ${_twin})
+            get_target_property(_twin_sources ${_twin} SOURCES)
+            list(REMOVE_ITEM args ${_twin_sources})
+        else()
+            set(_twin "")
+        endif()
+        _add_library(${name} ${args})   # the twin is linked into the final binary alongside it
+        if ("MODULE" IN_LIST ARGN)
+            # plugins become Qt static plugins; KoJsonTrader lists them via QPluginLoader::staticPlugins()
+            target_compile_definitions(${name} PRIVATE QT_STATICPLUGIN)
+        endif()
+    endfunction()
+endif()
+
