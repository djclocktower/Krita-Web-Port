--- /dev/null
+++ b/plugins/extensions/qmic/gmic-qt-web/CMakeLists.txt
@@ -0,0 +1,33 @@
+# WebAssembly build: the G'MIC-Qt host plugin ("krita-plugin" flavour of https://github.com/GreycLab/gmic-qt)
+# is compiled here as a static library from the sources in KRITA_WEB_GMIC_DIR (a clone of the gmic repository,
+# which holds src/ for the core and gmic-qt/). The G'MIC core itself is libgmic.a (and FFTW) in KRITA_WEB_GMIC_PREFIX.
+# Krita's trader finds the plugin through its Q_IMPORT_PLUGIN(KritaGmicPluginFactory) in the engine.
+# not the current directory first: ../ has Krita's stand-in gmic.h, which must not hide the real one
+set(CMAKE_INCLUDE_CURRENT_DIR OFF)
+set(_gq ${KRITA_WEB_GMIC_DIR}/gmic-qt)
+file(GLOB_RECURSE _gq_srcs ${_gq}/src/*.cpp)
+list(FILTER _gq_srcs EXCLUDE REGEX "/src/Host/")
+list(APPEND _gq_srcs ${_gq}/src/Host/KritaPlugin/host.cpp ${_gq}/src/Host/KritaPlugin/gmicqttoolplugin.cpp)
+file(GLOB _gq_forms ${_gq}/ui/*.ui)
+qt_wrap_ui(_gq_ui ${_gq_forms})
+qt_add_resources(_gq_rcc ${_gq}/gmic_qt.qrc)
+
+include_directories(BEFORE ${_gq}/src ${KRITA_WEB_GMIC_DIR}/src ${KRITA_WEB_PREFIX}/include ${KRITA_WEB_GMIC_PREFIX}/include)
+add_library(kritagmicqt STATIC ${_gq_srcs} ${_gq_ui} ${_gq_rcc})
+set_target_properties(kritagmicqt PROPERTIES AUTOMOC ON AUTOUIC OFF AUTORCC OFF)
+# The two interface headers the host includes, through a directory of their own: ../ has Krita's stand-in gmic.h,
+# which must not be on the include path. (The generated kritaqmicinterface_export.h is in ../'s build directory.)
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/include/kis_qmic_interface.h "#include \"${CMAKE_CURRENT_SOURCE_DIR}/../kis_qmic_interface.h\"\n")
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/include/kis_qmic_plugin_interface.h "#include \"${CMAKE_CURRENT_SOURCE_DIR}/../kis_qmic_plugin_interface.h\"\n")
+file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/include/kritaqmicinterface_export.h "#include \"${CMAKE_CURRENT_BINARY_DIR}/../kritaqmicinterface_export.h\"\n")
+target_include_directories(kritagmicqt PRIVATE ${CMAKE_CURRENT_BINARY_DIR}/include ${CMAKE_CURRENT_BINARY_DIR})
+add_dependencies(kritagmicqt kritaqmicinterface)
+# the flags gmic-qt's own CMake sets for this host (plus no curl, no OpenMP, no display, FFTW without threads)
+target_compile_definitions(kritagmicqt PRIVATE
+    QT_STATICPLUGIN QT_NO_DEBUG_OUTPUT cimg_use_cpp11=1 cimg_use_png cimg_use_zlib cimg_use_fftw3 cimg_use_fftw3_singlethread
+    gmic_core gmic_community cimg_use_abort gmic_is_parallel "cimg_appname=\"gmic\"" _IS_UNIX_ cimg_display=0
+    GMIC_HOST=krita-plugin _GMIC_QT_DISABLE_THEMING_ _GMIC_QT_CONSENT_TO_UPDATE_FIRST_ _GMIC_QT_DISABLE_UPDATES_ _GMIC_QT_DISABLE_TRANSLATION_
+    _GMIC_USE_HOSTED_SETTINGS_ _GMIC_ASYNC_IMAGE_UPDATE_ _GMIC_HOSTED_PLUGIN_)
+target_link_libraries(kritagmicqt PUBLIC Qt${QT_MAJOR_VERSION}::Widgets Qt${QT_MAJOR_VERSION}::Network KF${QT_MAJOR_VERSION}::CoreAddons)
+# gmic-qt uses Qt's "slots", "signals" and "emit" keywords, which Krita turns off globally
+target_compile_options(kritagmicqt PRIVATE -UQT_NO_SIGNALS_SLOTS_KEYWORDS -w)
