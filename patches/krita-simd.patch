diff --git a/CMakeLists.txt b/CMakeLists.txt
index bf8f52a..d0acf9c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1470,6 +1470,19 @@ if(LCMS2_FOUND)
     endif()
 endif()
 
+##
+## WebAssembly SIMD (xsimd::wasm). Needs -msimd128 everywhere, so the
+## xsimd headers see XSIMD_WITH_WASM; the scalar implementations stay
+## compiled and can be selected at runtime/with KRITA_WASM_SIMD=OFF.
+##
+if (EMSCRIPTEN)
+    option(KRITA_WASM_SIMD "Use xsimd's WebAssembly SIMD (simd128) backend" ON)
+    if (KRITA_WASM_SIMD)
+        string(APPEND CMAKE_C_FLAGS " -msimd128")
+        string(APPEND CMAKE_CXX_FLAGS " -msimd128")
+    endif()
+endif()
+
 ##
 ## Test for xsimd
 ##
@@ -1507,6 +1520,10 @@ if (xsimd_FOUND)
         if ("x86" IN_LIST XSIMD_ARCH OR "x86-64" IN_LIST XSIMD_ARCH)
             xsimd_compile_for_all_implementations(${_objs} ${_src} FLAGS ${xsimd_ARCHITECTURE_FLAGS} ONLY SSE2 SSSE3 SSE4_1 AVX AVX2+FMA)
         endif()
+
+        if ("wasm" IN_LIST XSIMD_ARCH)
+            xsimd_compile_for_all_implementations(${_objs} ${_src} FLAGS ${xsimd_ARCHITECTURE_FLAGS} ONLY WASM)
+        endif()
     endmacro()
 
     macro(ko_compile_for_all_implementations _objs _src)
diff --git a/cmake/modules/xsimd/xsimdMacros.cmake b/cmake/modules/xsimd/xsimdMacros.cmake
index a6c48dd..c02cdcb 100644
--- a/cmake/modules/xsimd/xsimdMacros.cmake
+++ b/cmake/modules/xsimd/xsimdMacros.cmake
@@ -95,7 +95,7 @@ macro(xsimd_set_available_architectures)
    if (NOT CMAKE_OSX_ARCHITECTURES)
       string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _processor)
       if (EMSCRIPTEN)
-         # Emscripten reports "x86"; there is no wasm SIMD implementation yet, so build scalar only
+         # Emscripten reports "x86"; do not use the x86 (SSE) code paths.
          set(_processor "wasm32")
       endif()
 
@@ -104,7 +104,12 @@ macro(xsimd_set_available_architectures)
       list(FIND _arm_aliases "${_processor}" _has_arm32)
       list(FIND _arm64_aliases "${_processor}" _has_aarch64)
 
-      if(_has_x86 GREATER -1)
+      if(EMSCRIPTEN AND KRITA_WASM_SIMD)
+         # xsimd::wasm (simd128); a single implementation, no runtime dispatch
+         list(APPEND _archs "wasm")
+      elseif(EMSCRIPTEN)
+         message(STATUS "KRITA_WASM_SIMD is OFF: building the scalar implementations only")
+      elseif(_has_x86 GREATER -1)
          list(APPEND _archs "x86")
       elseif(_has_amd64 GREATER -1)
          list(APPEND _archs "x86-64")
@@ -291,6 +296,11 @@ macro(xsimd_compile_for_all_implementations _srcs _src)
       _xsimd_compile_one_implementation(${_srcs} NEON64 NO_FLAG)
    endif()
 
+   if("wasm" IN_LIST XSIMD_ARCH)
+      _xsimd_compile_one_implementation(${_srcs} WASM
+         "-msimd128")
+   endif()
+
    if ("arm" IN_LIST XSIMD_ARCH)
       _xsimd_compile_one_implementation(${_srcs} NEON
          "-mfpu=neon")
