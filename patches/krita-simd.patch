diff --git a/libs/pigment/benchmarks/KoCompositeOpsBenchmark.cpp b/libs/pigment/benchmarks/KoCompositeOpsBenchmark.cpp
index 25a048d..dec853f 100644
--- a/libs/pigment/benchmarks/KoCompositeOpsBenchmark.cpp
+++ b/libs/pigment/benchmarks/KoCompositeOpsBenchmark.cpp
@@ -12,6 +12,7 @@
 
 #include <KoColorSpaceTraits.h>
 #include <KoColorSpaceRegistry.h>
+#include <KoColorModelStandardIds.h>
 
 #include <QRandomGenerator>
 
@@ -100,3 +101,31 @@ void KoCompositeOpsBenchmark::benchmarkCompositeAlphaDarkenCreamy()
 
 
 QTEST_GUILESS_MAIN(KoCompositeOpsBenchmark)
+
+void KoCompositeOpsBenchmark::benchmarkCompositeOverF32()
+{
+    // 1024x1024 RGBA F32 (16 MB per buffer), 64x64 tiles, opacity 0.5, no mask
+    const KoColorSpace *cs = KoColorSpaceRegistry::instance()->colorSpace(
+        RGBAColorModelID.id(), Float32BitsColorDepthID.id(), nullptr);
+    const int w = 1024, h = 1024;
+    const int px = cs->pixelSize();
+    QVector<float> src(w * h * 4), dst(w * h * 4);
+    QRandomGenerator rng(42);
+    for (int i = 0; i < src.size(); i++) {
+        src[i] = rng.generateDouble();
+        dst[i] = rng.generateDouble();
+    }
+    KoCompositeOp *compositeOp = KoOptimizedCompositeOpFactory::createOverOp128(cs);
+    QBENCHMARK{
+        for (int y = 0; y < h / TILE_HEIGHT; y++) {
+            for (int x = 0; x < w / TILE_WIDTH; x++) {
+                const int rowStride = w * px;
+                const int off = y * TILE_HEIGHT * rowStride + x * TILE_WIDTH * px;
+                compositeOp->composite(reinterpret_cast<quint8 *>(dst.data()) + off, rowStride,
+                                       reinterpret_cast<const quint8 *>(src.constData()) + off, rowStride,
+                                       nullptr, 0, TILE_WIDTH, TILE_HEIGHT, OPACITY_HALF);
+            }
+        }
+    }
+    delete compositeOp;
+}
